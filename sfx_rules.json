{
  "_help": "Categories = folder names in sfx_library (or your own SFX folder, which takes priority). Keywords are lowercase words/phrases in the narration. Edit freely.",
  "transitions": {"whip": "swoosh", "slide": "swipe", "zoom": "whoosh", "dip_black": "impact", "crossfade": ""},
  "overlays": {"hook": "bass_drop", "title": "hit_cinematic", "chapter": "impact", "label": "typing", "lower_third": "swipe"},
  "pre_roll": ["riser", "reverse_whoosh"],
  "max_seconds": {"typing": 1.6, "typewriter": 2.8, "tension": 4, "rumble": 3.5, "clock": 2.5, "engine_rev": 2.8},
  "gain_db": {"typing": 3, "key_click": 2, "mouse_click": 3, "clock": 3, "camera": 2, "rumble": -2, "tension": -4, "bass_drop": -2, "engine_rev": -3},
  "keywords": {
    "typing":     ["typed", "typing", "wrote", "email", "text message", "message", "hacker", "hacked", "code", "computer", "search", "googled", "report"],
    "typewriter": ["telegram", "typewriter", "letter", "memo", "document", "classified", "dispatch"],
