    "cash":       ["money", "dollars", "million", "billion", "profit", "paid", "price", "cost", "rich", "salary"],
    "ding":       ["notification", "idea", "realized", "discovered", "answer", "the truth", "solution"],
    "pop":        ["fun fact", "tip", "bonus", "quick", "trick"],
    "clock":      ["deadline", "countdown", "hours later", "minutes later", "midnight", "clock", "running out of time"],
    "heartbeat":  ["fear", "afraid", "heartbeat", "panic", "terrified", "nervous", "anxiety"],
    "glitch":     ["glitch", "error", "virus", "system", "malfunction", "crashed"],
