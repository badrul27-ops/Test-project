    "boom":       ["explosion", "exploded", "explode", "bomb", "blast", "detonated", "collapsed"],
    "impact":     ["suddenly", "but then", "shocking", "everything changed", "never again", "until one day"],
    "riser":      ["and then", "what happened next", "here's the thing", "but here's", "the real reason"],
    "tension":    ["secret", "mystery", "nobody knew", "hidden", "disappeared", "vanished"],
    "page_turn":  ["book", "page", "records", "archive", "history books", "diary"],
    "sparkle":    ["magic", "beautiful", "perfect", "shine", "gold"],
    "engine_rev": ["engine", "horsepower", "accelerate", "accelerated", "turbo", "v8", "rev"],
    "mouse_click":["click", "clicked", "button"],
    "punch":      ["hit", "punched", "strike", "knocked"]
